# SukiSU Nova kernel config for ruby (non-GKI, kernel 4.19)
# Based on SukiSU-Nova/SukiSU-Nova kernel/Kconfig (v3.x)
# Flash with matching SukiSU Nova manager app

# --- Prerequisites that SukiSU KSU depends on ---
# config KSU depends on KPROBES && EXT4_FS
CONFIG_KPROBES=y
CONFIG_HAVE_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_EXT4_FS=y

# --- SukiSU Nova core (real symbols from SukiSU kernel/Kconfig) ---
CONFIG_KSU=y
CONFIG_KSU_MANUAL_SU=y
CONFIG_KSU_DEBUG=n

# --- KPM support (SukiSU Nova feature; non-GKI needs KALLSYMS ALL) ---
CONFIG_KPM=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_KALLSYMS_BASE_RELATIVE=y
